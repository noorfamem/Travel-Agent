# TravelAI Pro Configuration
# Copy this file to ".env" (in the project root) and add your API keys.
# NEVER commit or share your ".env" file containing real secret keys.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- LLM Provider (Groq / OpenAI)
# Used for natural-language parsing and 12-hour hour-by-hour day plan structuring.
# Verified fast & free-tier compatible models on Groq: qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
# OPENAI_API_KEY=your_openai_key_here

# --- Tavily Web Search API
# Provides real-time web research for attractions, opening hours, official websites, and sources.
TAVILY_API_KEY=your_tavily_api_key_here

# --- SerpAPI (Google Flights & Google Hotels)
# Primary provider for real-time live flight fares and hotel inventory with pricing.
SERPAPI_API_KEY=your_serpapi_key_here
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en

# --- Aviationstack API (Optional)
# Flight status and schedules (no fare pricing). Free tier uses HTTP.
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_FUTURE_ENABLED=false

# --- Amadeus for Developers (Optional fallback flight fares)
# Register at https://developers.amadeus.com/self-service (free 500 test calls/mo).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Destination Scope
# Set to 'false' to allow worldwide destinations (e.g. Tirunelveli to Vietnam).
# Set to 'true' for strict domestic-only enforcement (28 Indian states + 8 UTs).
DOMESTIC_ONLY=false

# --- App Settings
DEFAULT_CURRENCY=INR
HTTP_TIMEOUT=25
HTTP_RETRIES=2
VERIFY_LINKS=true
DATABASE_URL=sqlite:///./data/travelai.db
